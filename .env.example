# Supabase project settings (required for persistent publishing)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Use separate long random secrets; keep both server-side only
CRON_SECRET=replace-with-a-long-random-secret
ADMIN_SECRET=use-a-different-long-random-secret

# Comma-separated RSS/Atom feeds you are permitted to monitor
JOB_FEEDS=https://example.gov.in/jobs/rss.xml,https://example.gov.in/results/feed.xml
DEFAULT_SOURCE_NAME=Official source

# Recommended: canonical production URL, without a trailing slash
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Supabase project settings (required for persistent publishing)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Long random secret used to protect the scheduled ingestion endpoint
CRON_SECRET=replace-with-a-long-random-secret
ADMIN_SECRET=use-a-different-long-random-secret
# Optional comma-separated RSS/Atom feeds. Prefer official source feeds only.
JOB_FEEDS=https://example.gov.in/jobs/rss.xml,https://example.gov.in/results/feed.xml
# Optional default source label
DEFAULT_SOURCE_NAME=Official source
